---

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Luis Rodríguez — NeoBmo",
  description = "Convierto ideas caóticas y procesos anticuados en herramientas simples.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Luis Rodríguez" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base.replace(/\/?$/, "/")}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
  </head>
  <body>
    <slot />
  </body>
</html>
